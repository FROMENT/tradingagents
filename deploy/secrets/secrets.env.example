# Template for the runtime secrets. This example is safe to commit; the real
# values are NOT.
#
# Workflow:
#   1. cp secrets.env.example secrets.plain.env   # fill in real values
#   2. sops --encrypt secrets.plain.env > secrets.enc.env   # commit ONLY this
#   3. rm secrets.plain.env
# The plaintext (secrets.env / secrets.plain.env) is gitignored. Only
# secrets.enc.env is committed. At runtime the host decrypts it into
# /run/tradingagents/secrets.env (tmpfs, mode 0600), which both services read.

# --- IBKR (consumed by the ib-gateway container) ---
# NOTE: with IBKR these are full account credentials, not a revocable API key —
# treat a leak as a full-account compromise and rotate immediately.
TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password
TRADING_MODE=paper            # paper | live  — keep paper until P5

# --- Slow-path LLM (consumed by the app container) ---
OPENROUTER_API_KEY=
# Optional direct providers (slow path only; latency is irrelevant off the hot path)
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# --- Runner safety ---
ALLOW_LIVE=0                  # must be 1 (with TRADING_MODE=live) to arm real trading
