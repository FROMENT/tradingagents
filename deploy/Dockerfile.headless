# Headless image for the intraday deployment (P3 scaffold).
#
# Build context is the REPOSITORY ROOT. Build it NATIVELY on ARM64 (the OCI
# Ampere host or an `ubuntu-24.04-arm` runner) — do not cross-build under QEMU.
#
#   docker build -f deploy/Dockerfile.headless -t tradingagents-intraday:local .
#
# Attack-surface note: this image installs ONLY `ib_async` (+ the stdlib
# `tradingagents.execution` package), NOT the full TradingAgents LLM framework
# (langchain/langgraph/pandas/yfinance/backtrader/redis). The headless runner
# and the deterministic execution layer need none of that, and the LLM "slow
# path" runs elsewhere — so the container that holds the broker credentials
# carries the minimum code. Pin `ib_async` to a known-good version here.

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Only the broker SDK. No project install -> none of the heavy framework deps.
RUN pip install --no-cache-dir "ib_async>=1.0.0"

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/home/appuser/app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home appuser \
 && install -d -m 0755 -o appuser -g appuser /home/appuser/.tradingagents
USER appuser
WORKDIR /home/appuser/app

# The stdlib-only execution layer (blocker/sizer/schemas) and the package
# __init__ (whose heavy imports are all guarded by suppressed ImportError, so it
# loads fine without the framework present), plus the scaffold runner.
COPY --chown=appuser:appuser tradingagents/__init__.py ./tradingagents/__init__.py
COPY --chown=appuser:appuser tradingagents/execution ./tradingagents/execution
COPY --chown=appuser:appuser deploy/runner ./runner

# SCAFFOLD entrypoint — connects, reconciles, heartbeats. Places no orders.
ENTRYPOINT ["python", "-m", "runner.heartbeat"]
